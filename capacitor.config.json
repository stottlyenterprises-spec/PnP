{
  "appId": "com.stottlyenterprises.progressnotperfection.deeds",
  "appName": "D.E.E.D.S.",
  "webDir": "native-dist",
  "backgroundColor": "#0e2019",
  "server": {
    "cleartext": false,
    "hostname": "localhost",
    "allowNavigation": [
      "p-n-p.vercel.app",
      "accounts.google.com",
      "cloud.ouraring.com",
      "moi.ouraring.com",
      "login.microsoftonline.com"
    ]
  },
  "ios": {
    "contentInset": "never",
    "preferredContentMode": "mobile"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "LocalNotifications": {
      "iconColor": "#4A8F90",
      "presentationOptions": [
        "badge",
        "sound",
        "banner",
        "list"
      ]
    }
  }
}
